type Value = 
 variant {
   "bool": bool;
   float: float64;
   "int": int;
   "nat": nat;
   "null";
   "text": text;
 };
type UserRole = 
 variant {
   admin;
   guest;
   user;
 };
type Timestamp = int;
type TeamId = nat;
type Team = 
 record {
   city: text;
   id: TeamId;
   logo: text;
   name: text;
   squad: vec text;
 };
type StandingRow = 
 record {
   drawn: nat;
   lost: nat;
   played: nat;
   points: nat;
   position: nat;
   teamName: text;
   won: nat;
 };
type Standing = 
 record {
   competition: text;
   rows: vec StandingRow;
 };
type Scorer = 
 record {
   minute: nat;
   playerName: text;
   teamName: text;
 };
type Result__1 = 
 variant {
   err: Error;
   ok;
 };
type Result = 
 record {
   hasMore: bool;
   rows: vec vec Cell;
 };
type PlayerStats = 
 record {
   assists: nat;
   goals: nat;
   matches: nat;
 };
type PlayerId = nat;
type Player = 
 record {
   id: PlayerId;
   name: text;
   photo: text;
   position: text;
   stats: PlayerStats;
   teamName: text;
 };
type NewsId = nat;
type News = 
 record {
   category: text;
   content: text;
   id: NewsId;
   image: text;
   publishedAt: Timestamp;
   summary: text;
   title: text;
 };
type MatchStatus = 
 variant {
   finished;
   live;
   upcoming;
 };
type MatchId = nat;
type Match = 
 record {
   awayScore: opt nat;
   awayTeam: text;
   competition: text;
   homeScore: opt nat;
   homeTeam: text;
   id: MatchId;
   kickoff: Timestamp;
   lineup: Lineup;
   scorers: vec Scorer;
   status: MatchStatus;
   summary: text;
 };
type Lineup = 
 record {
   away: vec text;
   home: vec text;
 };
type Error = 
 variant {
   AmbiguousAttribute: record {
                         field: text;
                         sources: vec text;
                       };
   FrontendOriginMismatch: record {
                             expected: vec text;
                             got: text;
                           };
   FrontendOriginsNotConfigured;
   MalformedCandid;
   MissingField: text;
   MixedSsoSources: record {
                      otherKeys: vec text;
                      ssoKeys: vec text;
                    };
   NoAttributes;
   Stale: record {ageNs: nat;};
   UnknownNonce;
   UntrustedSsoSource: record {domain: text;};
 };
type Cell = 
 record {
   name: text;
   value: Value;
 };
type AdSlot = 
 record {
   enabled: bool;
   id: text;
   imageUrl: text;
   placement: text;
   targetUrl: text;
 };
service : {
  _initialize_access_control: () -> ();
  _internet_identity_sign_in_finish: () -> (Result__1);
  _internet_identity_sign_in_start: () -> (blob);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  execute: (qJson: text) -> (Result) query;
  getApiDoc: () -> (text) query;
  getCallerUserRole: () -> (UserRole) query;
  getMatch: (id: MatchId) -> (opt Match) query;
  getNews: (id: NewsId) -> (opt News) query;
  getPlayer: (id: PlayerId) -> (opt Player) query;
  getStanding: (competition: text) -> (opt Standing) query;
  getTeam: (id: TeamId) -> (opt Team) query;
  isCallerAdmin: () -> (bool) query;
  listAdSlots: () -> (vec AdSlot) query;
  listCompetitions: () -> (vec text) query;
  listMatches: (competition: opt text, status: opt MatchStatus) ->
   (vec Match) query;
  listNews: () -> (vec News) query;
  listPlayers: (position: opt text, teamName: opt text) -> (vec Player) query;
  listTeams: () -> (vec Team) query;
  schema: () -> (text) query;
}
